# ClimateShield — example environment.
# Copy to .env:  cp .env.example .env
# Every value here is a non-secret development default. The system runs with
# zero credentials; nothing below grants access to any external service.

# Postgres (docker-compose creates this database locally)
POSTGRES_USER=climateshield
POSTGRES_PASSWORD=climateshield
POSTGRES_DB=climateshield
# Host-side DSN (make demo, tests, migrations run from the host)
DATABASE_URL=postgres://climateshield:climateshield@localhost:5432/climateshield?sslmode=disable

# AES-256-GCM key for PII columns (64 hex chars).
#
# THIS EXACT VALUE IS PUBLISHED IN A PUBLIC REPOSITORY. Anything encrypted
# under it is effectively plaintext. Services refuse to start with it unless
# PII_ALLOW_DEV_KEY=true, so a deployment that forgets to set a real key fails
# rather than silently protecting nothing.
#
# Generate a real one per deployment, on the host:  openssl rand -hex 32
PII_KEY_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
PII_ALLOW_DEV_KEY=true

# Climate source:
#   fixture   — committed golden JSON (testdata/golden). Deterministic and
#               fully offline; this is the default so that `make up && make
#               demo` reproduces the documented scenario on any machine,
#               including one with no internet access.
#   openmeteo — live Open-Meteo forecasts (free, no API key). Real data, so
#               the risk levels you see depend on the actual weather.
# Live ingestion always wins over fixtures when both are present, because the
# predictor scores the most recently ISSUED forecast window.
CLIMATE_SOURCE=fixture
OPENMETEO_BASE_URL=https://api.open-meteo.com

# Notification channel: mock (JSONL to disk — CI/demo default) | smpp
# smpp is wired but untested against a live carrier; africastalking is a stub.
NOTIFY_CHANNEL=mock
MOCK_OUTBOX_PATH=var/outbox.jsonl

# SMPP (only read when NOTIFY_CHANNEL=smpp; dummy defaults)
SMPP_ADDR=localhost:2775
SMPP_SYSTEM_ID=climateshield
SMPP_PASSWORD=dev-only

# Ledger anchoring: local | evm
#   local — daily Merkle roots are recorded in the anchors table of this
#           system's own database, and nowhere else.
#   evm   — roots are ALSO written to the RootAnchor contract on the EVM chain
#           at ANCHOR_RPC_URL and read back before being reported as anchored.
#
# The default stack runs `evm` against the `anvil` service in docker-compose:
# a single-node DEVELOPMENT chain (id 31337) started by this deployment. It is
# not a public network, it needs no key — anvil's first account is unlocked,
# which is why this works with zero credentials — and its history is deleted
# by `make down -v`. Every surface that reports an anchor says which chain it
# was and what kind of chain that is.
#
# Anchoring to a public network is deliberately NOT wired: it would require a
# funded signing key, which this project's zero-credential rule forbids.
ANCHOR_MODE=evm
ANCHOR_RPC_URL=http://localhost:8545
# Sending account; empty uses the node's first unlocked development account.
ANCHOR_FROM=
# Pin an already-deployed RootAnchor; empty deploys once per chain and
# remembers the address in the anchor_contracts table.
ANCHOR_CONTRACT_ADDRESS=
ANCHOR_CONFIRM_TIMEOUT=30s

# County risk briefings (the generative-AI pillar).
#
# BRIEFING_GENERATOR selects who writes the prose:
#   mock      — a deterministic template. NO language model runs, and every
#               briefing says exactly that on its first line. This is the
#               default, and it is why `make up` works offline with zero
#               credentials.
#   openai    — a locally hosted open-weights model behind an
#               OpenAI-compatible endpoint. `make up-ai` starts one (Ollama +
#               qwen2.5:1.5b, Apache-2.0); see deploy/docker-compose.ai.yml.
#               No credential: the bearer token below is a placeholder that a
#               local server ignores.
#   anthropic — the Claude API. Requires ANTHROPIC_API_KEY, which this
#               repository never ships and CI never sets. Leave it empty and
#               this generator cannot be selected: the service refuses to
#               start rather than pretend a model is configured.
#
# Whatever writes the prose, a grounding check runs on every draft: a briefing
# containing a number, county, disease or risk level that is not in the fact
# sheet it was generated from is REJECTED, the template is served instead, and
# the rejection reasons are published on GET /v1/briefings. Generated text is
# never sent to a guardian — SMS comes from the fixed templates only.
BRIEFING_GENERATOR=mock
# Model identifier; empty uses the selected generator's default
# (qwen2.5:1.5b for openai, claude-opus-5 for anthropic).
BRIEFING_MODEL=
# How often the service checks whether a county's fact sheet has changed.
# Unchanged facts regenerate nothing.
BRIEFING_SWEEP_INTERVAL=15m
# Bound on one generation. Briefings are written by a background job, never in
# a request, so a slow local model delays nothing a reader is waiting for.
BRIEFING_TIMEOUT=120s
BRIEFING_OPENAI_BASE_URL=http://localhost:11434/v1
BRIEFING_OPENAI_API_KEY=
# Not a credential this project has, needs or ships. Set it only if you
# deliberately choose BRIEFING_GENERATOR=anthropic.
ANTHROPIC_API_KEY=

# Service listen addresses
PUBLICAPI_ADDR=:8080
REGISTRY_ADDR=:8082
INGESTOR_ADDR=:8090
PREDICTOR_ADDR=:8091
NOTIFIER_ADDR=:8092
LEDGER_ADDR=:8093
BRIEFING_ADDR=:8094

# Logging: debug | info | warn | error (JSON to stdout, PII-redacted)
LOG_LEVEL=info
